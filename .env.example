# Copy to .env and replace every "change-me" value. Never commit .env.
ENVIRONMENT=production

# --- PostgreSQL (docker compose) -------------------------------------------
POSTGRES_DB=neurogrip
POSTGRES_USER=neurogrip
POSTGRES_PASSWORD=change-me-db-password

# For running the backend outside Docker you can set DATABASE_URL directly:
# DATABASE_URL=postgresql+psycopg://neurogrip:change-me-db-password@localhost:5432/neurogrip
# (leave unset for the zero-config SQLite fallback: backend/neurogrip.db)

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Shared key that sensor devices send in the X-Device-Key header
SENSOR_DEVICE_KEY=change-me-device-key
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8080

# --- Bootstrap accounts ----------------------------------------------------
ADMIN_EMAIL=admin@neurogrip.dev
ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO_USER=true
DEMO_EMAIL=demo@neurogrip.dev
DEMO_PASSWORD=demo-password-2026

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_UPLOAD_ROWS=20000
SIMULATED_STREAM_RATE_HZ=4

# --- Ports (docker compose) ------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000
