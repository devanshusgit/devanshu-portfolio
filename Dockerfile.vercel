# Single-container image for Vercel (and any container host that sets $PORT):
# the FastAPI backend also serves the built React frontend on one origin,
# so /api, /ws and the SPA share a domain (no CORS, WebSockets on the same host).

FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ENV VITE_API_URL=""
RUN npm run build

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MODEL_DIR=/app/artifacts \
    FRONTEND_DIST=/app/static \
    DB_POOL_SIZE=4 \
    DB_MAX_OVERFLOW=4
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install -r requirements.txt
COPY backend/app ./app
COPY backend/scripts ./scripts
# Deterministic training at build time (seed 42). ENVIRONMENT is forced to
# development here only because runtime secrets are not needed to train.
RUN ENVIRONMENT=development python -m app.ml.train --out /app/artifacts
COPY --from=web /web/dist /app/static

EXPOSE 8080
# One worker: the live-sensor hub (WebSocket fan-out) is in-process.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips '*'"]
